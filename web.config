<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <handlers>
            <add name="PythonHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified"/>
        </handlers>
        <httpPlatform processPath="C:\inetpub\wwwroot\e-randevu\dental_management_system\venv\Scripts\python.exe"
                      arguments="C:\inetpub\wwwroot\e-randevu\dental_management_system\manage.py runserver 0.0.0.0:%HTTP_PLATFORM_PORT%"
                      stdoutLogEnabled="true"
                      stdoutLogFile="C:\inetpub\wwwroot\e-randevu\dental_management_system\logs\iis.log"
                      startupTimeLimit="60"
                      requestTimeout="00:04:00">
            <environmentVariables>
                <environmentVariable name="DJANGO_SETTINGS_MODULE" value="dental.settings"/>
                <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%"/>
            </environmentVariables>
        </httpPlatform>
    </system.webServer>
</configuration>